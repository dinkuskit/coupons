{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinkus-coupons-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "durable_objects": { "bindings": [{ "name": "STORE_COUPONS", "class_name": "StoreCoupons" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreCoupons"] }],
  "vars": {
    "ACCOUNT_ISSUER": "",
    "ACCOUNT_AUDIENCE": "",
    "ACCOUNT_JWKS_URL": ""
  }
}
